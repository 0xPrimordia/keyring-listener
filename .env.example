# Hedera operator (must have submit permission on agent inbound topics)
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# Network: testnet | mainnet
HEDERA_NETWORK=testnet

# Hgraph JSON-RPC Relay (https://docs.hgraph.com/json-rpc/overview)
# Set HGRAPH_PUBLIC_KEY to use Hgraph; URLs are built automatically per network.
HGRAPH_PUBLIC_KEY=
HGRAPH_SECRET_KEY=

# Optional overrides (defaults: Hgraph when key set, else Hashio)
# RPC_RELAY_WS_URL=wss://testnet.hedera.api.hgraph.io/v1/<API_KEY>/rpc
# RPC_RELAY_HTTP_URL=https://testnet.hedera.api.hgraph.io/v1/<API_KEY>/rpc

# Deployed ScheduleReviewTrigger contract address (EVM format, e.g. 0x...)
SCHEDULE_REVIEW_TRIGGER_CONTRACT_ADDRESS=

# Optional: log level (debug | info | warn | error)
# LOG_LEVEL=info

# Optional: WebSocket hardening for testnet (see docs/testnet-hardening.md)
# WS_RECONNECT_BASE_MS=3000
# WS_RECONNECT_MAX_MS=60000
# WS_PING_INTERVAL_MS=0  # 0=disabled (default; Hashio may not respond to pings)
# WS_PONG_TIMEOUT_MS=10000
